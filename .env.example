# Copy to .env and fill in.
DATABASE_URL=sqlite:///./professor_io.db
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# Get a key at https://aistudio.google.com/apikey. Without it, AI features return 503
# and recommendations fall back to student-selected review tags only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
