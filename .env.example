# Copy to .env and fill in.
DATABASE_URL=sqlite:///./professor_io.db
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# Get a key at https://aistudio.google.com/apikey. Without it, AI features return 503
# and recommendations fall back to student-selected review tags only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Usage limits for Gemini calls (viewing saved AI results never counts).
GEMINI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_USER_PER_HOUR=20
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Only allow sign-ups from these email domains, e.g. ["edu"]. Leave as [] to allow any.
ALLOWED_EMAIL_DOMAINS=[]
# Email for verification codes. Leave SMTP_HOST empty to print codes in the server log instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, your address as SMTP_USERNAME,
# and an App Password (https://myaccount.google.com/apppasswords) as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Professor.io <no-reply@professor.io>
