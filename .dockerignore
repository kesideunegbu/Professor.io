# Files Docker should NOT copy into the backend image.
# Secrets: pass settings at runtime (docker run --env-file / compose env_file) instead.
.env
.env.*
!.env.example

# Local databases and Python leftovers
*.db
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Not needed inside the backend image
.git/
.github/
.vscode/
frontend/
tests/
*.md
